# Groq API (Agent 3 — Threat Intel)
GROQ_API_KEY=YOUR_KEY_HERE

# ===== LLM COUNCIL =====
# Each agent is "provider:model". All three use Groq (cloud, free tier).
# Providers also supported: ollama | lmstudio (see MANUAL.md) - no code change needed.
# Any agent whose model fails is retried on GROQ_FALLBACK_MODEL.
PRIMARY_LLM_PROVIDER=hybrid
LLM_PROVIDER=hybrid

ANALYST_MODEL=groq:qwen/qwen3.8-27b
ENGINEER_MODEL=groq:openai/gpt-oss-20b
INTEL_MODEL=groq:allam-2-7b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
# Groq limits are per model per day (and per Groq account). If one model runs out, swap it here.

# Council tuning
COUNCIL_TEMPERATURE=0.3
COUNCIL_MAX_TOKENS=512

# Data Paths
DATA_RAW_PATH=data/raw
DATA_PROCESSED_PATH=data/processed
DATA_SYNTHETIC_PATH=data/synthetic

# ===== PATHS =====
DATA_PATH=data/raw/Darknet.xlsx
MODEL_PATH=models/trained/ensemble_detector.pkl
SYNTHETIC_DATA_PATH=data/synthetic/
MODEL_CHECKPOINT_PATH=models/checkpoints
MODEL_TRAINED_PATH=models/trained

# Detector Config
DETECTOR_MODEL_TYPE=xgboost
DETECTOR_THRESHOLD=0.5
DETECTOR_ENSEMBLE=true

# Logging
LOG_LEVEL=INFO
LOG_PATH=logs/
DEBUG=False
BATCH_SIZE=64
SEED=42

# ── Kafka ────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_RAW_FLOWS_TOPIC=raw-flows
KAFKA_THREATS_TOPIC=threats
KAFKA_DECISIONS_TOPIC=decisions
KAFKA_SERVER_REGISTRY_TOPIC=server-registry
KAFKA_CONSUMER_GROUP=agentic-ids-group
KAFKA_NUM_PARTITIONS=6

# ── AegisFlow (production mode — C binary) ───────────────────
AEGISFLOW_BINARY=./AegisFlow/build/aegisflow
AEGISFLOW_INTERFACE=eth0
AEGISFLOW_PCAP=                           # optional: path to .pcap for offline replay

# ── This server's identity (used by FlowProducer) ────────────
SERVER_ID=MUM-01
GEO_REGION=asia-south1
SERVER_IP=127.0.0.1

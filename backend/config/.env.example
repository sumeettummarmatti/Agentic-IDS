# Groq API (Agent 3 — Threat Intel)
GROQ_API_KEY=YOUR_KEY_HERE

# ===== LLM COUNCIL — HYBRID MODE =====
# Each of the 3 council agents uses a different provider:
#   Agent 1 (Security Analyst) → Groq (LM Studio timed-out, switched to Groq)
#   Agent 2 (ML Engineer)      → Groq (Ollama timed-out, switched to Groq)
#   Agent 3 (Threat Intel)     → Groq (cloud, tiny context window)
PRIMARY_LLM_PROVIDER=hybrid
LLM_PROVIDER=hybrid

# ─ Agent 1: Security Analyst ─────────────────────────────────────────────────
# NOTE: Was lmstudio:qwen2.5-coder-7b-instruct but LM Studio is not running.
# Uncomment below to re-enable LM Studio when it's running:
# ANALYST_MODEL=lmstudio:qwen2.5-coder-7b-instruct
ANALYST_MODEL=groq:llama-3.1-8b-instant

# ─ Agent 2: ML Engineer ─────────────────────────────────────────────────────
# NOTE: llama3-8b-8192 is DECOMMISSIONED by Groq.
# Using gemma2-9b-it which has a SEPARATE TPM pool (avoids rate-limiting analyst+intel).
# Uncomment below to re-enable Ollama when it's responsive:
# ENGINEER_MODEL=ollama:qwen3:8b
ENGINEER_MODEL=groq:gemma2-9b-it

# ─ Agent 3: Groq Threat Intel ──────────────────────────────────────────────
# Using a different model slug to avoid sharing TPM budget with analyst.
# llama-3.1-8b-instant and gemma2-9b-it have separate per-model limits.
INTEL_MODEL=groq:llama-3.1-8b-instant

# Council tuning
COUNCIL_TEMPERATURE=0.3
COUNCIL_MAX_TOKENS=512

# Data Paths
DATA_RAW_PATH=data/raw
DATA_PROCESSED_PATH=data/processed
DATA_SYNTHETIC_PATH=data/synthetic

# ===== PATHS =====
DATA_PATH=data/raw/Darknet.xlsx
MODEL_PATH=models/trained/ensemble_detector.pkl
SYNTHETIC_DATA_PATH=data/synthetic/
MODEL_CHECKPOINT_PATH=models/checkpoints
MODEL_TRAINED_PATH=models/trained

# Detector Config
DETECTOR_MODEL_TYPE=xgboost
DETECTOR_THRESHOLD=0.5
DETECTOR_ENSEMBLE=true

# Logging
LOG_LEVEL=INFO
LOG_PATH=logs/
DEBUG=False
BATCH_SIZE=64
SEED=42

# ── Kafka ────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_RAW_FLOWS_TOPIC=raw-flows
KAFKA_THREATS_TOPIC=threats
KAFKA_DECISIONS_TOPIC=decisions
KAFKA_SERVER_REGISTRY_TOPIC=server-registry
KAFKA_CONSUMER_GROUP=agentic-ids-group
KAFKA_NUM_PARTITIONS=6

# ── AegisFlow (production mode — C binary) ───────────────────
AEGISFLOW_BINARY=./AegisFlow/build/aegisflow
AEGISFLOW_INTERFACE=eth0
AEGISFLOW_PCAP=                           # optional: path to .pcap for offline replay

# ── This server's identity (used by FlowProducer) ────────────
SERVER_ID=MUM-01
GEO_REGION=asia-south1
SERVER_IP=127.0.0.1

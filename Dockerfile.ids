# Dockerfile.ids
# ─────────────────────────────────────────────────────────────
# Full IDS pipeline container — runs main.py --mode production.
# Reads flows from Kafka raw-flows topic, runs ML + LLM council,
# writes decisions back to Kafka and exposes the dashboard at :5001.
# ─────────────────────────────────────────────────────────────
FROM python:3.12-slim

WORKDIR /app

# System deps for torch / sklearn / librdkafka python binding
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Python deps (full stack)
# torch first, CPU-only: the default PyPI build drags in several GB of NVIDIA CUDA
# libraries this project never uses, which makes the build slow and prone to timeouts.
# Generous timeout/retries so a slow connection does not fail the build.
ENV PIP_DEFAULT_TIMEOUT=120 PIP_RETRIES=10
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu
COPY backend/requirements.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Source code
COPY backend/src/   src/
COPY backend/main.py .
COPY backend/config/ config/

# Dashboard HTML. server_manager.py resolves it as <three dirs above src/ui>/frontend,
# which is /frontend when the code lives in /app/src/ui — so it must be copied here.
COPY frontend/ /frontend/

# Data & models are mounted from host via docker-compose volumes
# (data/ and models/ are too large to bake into the image)

# Expose Server Manager dashboard port
EXPOSE 5001

# Default: UI mode = Kafka consumer pipeline + Server Manager dashboard on :5001.
# Servers start un-monitored: click "Monitor" on the map, or start the stack with
# AUTO_MONITOR=all (or a list like MUM-01,LON-01) to analyse flows immediately.
CMD ["python", "main.py", "--mode", "ui"]
